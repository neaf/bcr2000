$rev R1
$preset
.name 'snapshot test'
.snapshot off
.request off
.egroups 4
.fkeys on
.lock off
.init
$encoder 1
.easypar CC 2 7 0 127 absolute
.default 64
$encoder 2
.easypar CC 2 1 0 16383 absolute/14
.default 8192
$encoder 3
.easypar CC 2 10 0 127 relative-1
.default 50
$encoder 4
.easypar NRPN 2 1000 0 127 absolute
.default 100
$encoder 5
.easypar NRPN 2 1000 0 16383 absolute/14
.default 8192
$encoder 6
.easypar NRPN 2 1001 0 127 inc/dec
.default 20
$encoder 7
.easypar PC 2 5 6
.default 9
$encoder 8
.easypar PB 2 100
.default 70
$encoder 9
.easypar AT 2 all 0 127
.default 33
$encoder 10
.easypar AT 2 60 0 127
.default 44
$encoder 11
.easypar GS/XG 2 panorama 0 127
.default 80
$encoder 12
.easypar GS/XG 2 cutoff 0 127
.default 90
$encoder 33
.easypar CC 2 74 0 127 absolute
.default 99
$button 1
.easypar CC 3 7 127 0 toggleon
.default 127
$button 2
.easypar CC 3 8 127 0 toggleon
.default 0
$button 3
.easypar CC 3 9 127 off toggleoff
.default 127
$button 4
.easypar NRPN 3 1000 100 50 toggleon
.default 100
$button 5
.easypar NOTE 3 60 100 toggleoff
.default 100
$button 6
.easypar PC 3 5 6 7
.default 7
$button 7
.easypar AT 3 all 100 20 toggleon
.default 100
$button 8
.easypar AT 3 61 100 20 toggleon
.default 100
$button 9
.easypar GS/XG 3 cutoff 90 10 toggleon
.default 90
$button 10
.easypar GS/XG 3 volume 90 10 toggleon
.default 90
$button 11
.easypar CC 3 20 10 1 increment 2
.default 5
$button 12
.easypar MMC all play 00:00:00.00 noloc
$button 13
.easypar MMC 5 locate 01:02:03.04 25f
$button 14
.easypar CC 3 30 16000 100 toggleon
.default 16000
$end
