      ],
      "range_from_device": [
        0,
        65535
      ],
      "practical_max": 32673,
      "default": [
        0,
        0,
        0,
        0
      ],
      "rule": "omitted values repeat the last supplied value"
    },
    "standard_types": [
      "PC",
      "CC",
      "NRPN",
      "PB",
      "AT",
      "GS/XG"
    ],
    "standard_modes": [
      "absolute",
