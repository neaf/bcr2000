  "fader": {
    "selector": "$fader 1..9 (BCF); BCR returns error 9",
    "defaults": {
      "motor": false,
      "override": "move",
      "keyoverride": "off"
    },
    "statements": {
      ".motor": {
        "syntax": ".motor off|on",
