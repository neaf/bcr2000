{
  "meta": {
    "name": "Behringer B-Control BCR2000 / BCF2000 protocol and preset model",
    "version": "1.1",
    "core_scope": "device preset and communication only",
    "confidence": "protocol sections are consistent across descriptions of firmware 1.10; identity-string handling and raw memory fields are partly uncertain"
  },
  "manufacturer": {
    "name": "Behringer",
    "sysex_id": [
      0,
      32,
      50
    ]
  },
  "models": {
    "BCF2000": 20,
    "BCR2000": 21,
    "ANY": 127
  },
  "device_id": {
    "range": [
      1,
      16
    ],
    "wire_range": [
      0,
      15
    ],
    "wire_value": "device_id - 1",
    "any": 127,
    "note": "A device replies with its own ID; requests may use ANY."
  },
  "sysex": {
    "frame": [
      "F0",
      "00 20 32",
      "device",
      "model",
      "command",
      "data...",
      "F7"
    ],
    "commands": {
      "1": {
        "name": "Request Identity",
        "request": true,
        "reply": 2,
        "data": "none",
        "note": "Hosts commonly send device 0x7F and model 0x7F."
      },
      "2": {
        "name": "Send Identity",
        "reply": true,
        "data": "identity string (e.g. 'BCR2000 1.10'); some hosts only read the 8-byte header"
      },
      "32": {
        "name": "Send BCL Message",
        "request": true,
        "reply": 33,
        "data": "14-bit message index (2 bytes, MSB first) + BCL text"
      },
      "33": {
        "name": "BCL Reply",
        "reply": true,
        "data": "14-bit index (2 bytes, MSB first) + error code"
      },
      "34": {
        "name": "Select Preset",
        "request": true,
        "reply": null,
        "data": "0..31 (memory preset - 1)"
      },
      "52": {
        "name": "Send Firmware",
        "request": true,
        "reply": 53,
        "data": "296 encrypted bytes"
      },
      "53": {
        "name": "Firmware Reply",
        "reply": true,
        "data": "2-byte address (address / 0x100, MSB first) + error code"
      },
      "64": {
        "name": "Request Data",
        "request": true,
        "reply": 32,
        "data": "0..31 memory preset, 0x7E global setup and all 32 presets (empty ones included), 0x7F temporary preset"
      },
      "65": {
        "name": "Request Global Setup",
        "request": true,
        "reply": 32,
        "data": "none"
      },
      "66": {
        "name": "Request Preset Name",
        "request": true,
        "reply": 33,
        "data": "0..31 memory preset, 0x7E all names, 0x7F temporary"
      },
      "67": {
        "name": "Request Snapshot",
        "request": true,
        "reply": null,
        "data": "none; device replies with ordinary MIDI output, not BCL"
      },
      "120": {
        "name": "Send Text",
        "request": true,
        "reply": null,
        "data": "first character index + characters (BCF emulation display)"
      }
    }
  },
  "bcl": {
    "message_frame": {
      "bytes": [
        "F0",
        "00 20 32",
        "device",
        "model",
        "0x20",
        "index MSB (7-bit)",
        "index LSB (7-bit)",
        "text bytes 0x20..0x7F",
        "F7"
      ],
      "index_range": [
        0,
        16383
      ],
      "index_rule": "first line index 0, increment by 1 for each line",
      "text_chars": "0x20..0x7F; comments after ';'",
      "line_limit": "about 512 characters on the device"
    },
    "chain_rules": {
      "start": "first message index 0 normally contains '$rev'",
      "end": "last message normally contains '$end'",
      "reply": "every BCL line receives a BCL Reply with the same index",
      "index_0": "a message with index 0 starts a new chain on the device",
      "wrap": "index wraps to 0 after 16383; the device cannot re-read chains longer than 16384 lines",
      "case_sensitive": true,
      "comments": "';' starts a comment; '#' and '//' are not comments",
      "spaces": "extra spaces between identifiers are allowed"
    },
    "sections": [
      "$global",
      "$preset",
      "$button N",
      "$encoder N",
      "$fader N"
    ],
    "block_statements": {
      "$rev": "block start; '$rev R1' for BCR, '$rev F1' for BCF; revision may be omitted; must not start with '0'",
      "$end": "block end"
    },
    "commands": {
      "$recall N": "load memory preset N (1..32) into temporary preset",
      "$store N": "store temporary preset as memory preset N (1..32)"
    },
    "errors": {
      "0": {
        "token": "noerr",
        "bc_edit": "OK",
        "meaning": "No error"
      },
      "1": {
        "token": "unknowntoken",
        "bc_edit": "unknown token",
        "meaning": "Invalid identifier after '$' or '.'"
      },
      "2": {
        "token": "datawithouttoken",
        "bc_edit": "data without token",
        "meaning": "'$' or '.' expected"
      },
      "3": {
        "token": "argumentmissing",
        "bc_edit": "argument missing",
        "meaning": "MIDI output argument expected"
      },
      "4": {
        "token": "wrongdevice",
        "bc_edit": "wrong device",
        "meaning": "Invalid model in $rev; terminates current section"
      },
      "5": {
        "token": "wrongrevision",
        "bc_edit": "wrong revision",
        "meaning": "Unsupported revision; terminates block"
      },
      "6": {
        "token": "missingrevision",
        "bc_edit": "missing revision",
        "meaning": "No block defined (statement outside $rev/$end)"
      },
      "7": {
        "token": "internal",
        "bc_edit": "none",
        "meaning": "Unknown/internal"
      },
      "8": {
        "token": "modemissing",
        "bc_edit": "mode missing",
        "meaning": "No section defined (dot statement outside section)"
      },
      "9": {
        "token": "baditemindex",
        "bc_edit": "bad item index",
        "meaning": "Element number out of range"
      },
      "10": {
        "token": "notanumber",
        "bc_edit": "not a number",
        "meaning": "Invalid numerical argument"
      },
      "11": {
        "token": "valoutofrange",
        "bc_edit": "value out of range",
        "meaning": "Argument value out of range"
      },
      "12": {
        "token": "invalidargument",
        "bc_edit": "invalid argument",
        "meaning": "Invalid text argument"
      },
      "13": {
        "token": "invalidcommand",
        "bc_edit": "invalid command",
        "meaning": "Setting not allowed in current section"
      },
      "14": {
        "token": "wrongnumberofargs",
        "bc_edit": "wrong number of arguments",
        "meaning": "Invalid number of arguments"
      },
      "15": {
        "token": "toomuchdata",
        "bc_edit": "too much data",
        "meaning": "LEARN/custom output buffer (127 bytes) overflow"
      },
      "16": {
        "token": "alreadydefined",
        "bc_edit": "already defined",
        "meaning": "unknown"
      },
      "17": {
        "token": "presetmissing",
        "bc_edit": "preset missing",
        "meaning": "unknown"
      },
      "18": {
        "token": "presettoocomplex",
        "bc_edit": "preset too complex",
        "meaning": "Preset definition exceeds 4344 bytes (BCR) / 4956 bytes (BCF); memory preset unchanged. Over MIDI the device does not report it: $store replies 0 and the slot is unchanged"
      },
      "19": {
        "token": "wrongpreset",
        "bc_edit": "wrong preset",
        "meaning": "unknown"
      },
      "20": {
        "token": "presettoonew",
        "bc_edit": "preset to onew",
        "meaning": "unknown"
      },
      "21": {
        "token": "presetcheck",
        "bc_edit": "preset check",
        "meaning": "unknown"
      },
      "22": {
        "token": "sequence",
        "bc_edit": "sequence error",
        "meaning": "Invalid message index"
      },
      "23": {
        "token": "wrongcontext",
        "bc_edit": "wrong context",
        "meaning": "unknown"
      }
    }
  },
  "counts": {
    "BCR2000": {
      "buttons": 64,
      "encoders": 56,
      "faders": 0,
      "encoder_groups": 4,
      "memory_presets": 32,
      "max_definition_bytes": 4344
    },
    "BCF2000": {
      "buttons": 64,
      "encoders": 32,
      "faders": 9,
      "encoder_groups": 4,
      "memory_presets": 32,
      "max_definition_bytes": 4956
    }
  },
  "button_map": {
    "1-8": "push encoders, encoder group 1",
    "9-16": "push encoders, group 2 (active when egroups >= 2)",
    "17-24": "push encoders, group 3 (active when egroups >= 3)",
    "25-32": "push encoders, group 4 (active when egroups == 4)",
    "33-40": "upper row keys",
    "41-48": "lower row keys",
    "49-52": "user keys",
    "53-56": "function keys STORE/LEARN/EDIT/EXIT (buttons when fkeys=off or lock=on)",
    "57-60": "ENCODER GROUPS keys (or group selectors)",
    "61": "foot switch 1 (BCR) / foot switch (BCF)",
    "62": "foot switch 2 (BCR only; BCF accepts the definition)",
    "63-64": "PRESET = / PRESET < (buttons when lock=on)"
  },
  "encoder_map": {
    "1-8": "push encoders, group 1",
    "9-16": "push encoders, group 2",
    "17-24": "push encoders, group 3",
    "25-32": "push encoders, group 4",
    "33-40": "top row rotary encoders (BCR)",
    "41-48": "middle row rotary encoders (BCR)",
    "49-56": "bottom row rotary encoders (BCR)",
    "BCF2000": "encoders 1..32 only"
  },
  "global_setup": {
    "selector": "$global",
    "dump_order": [
      ".midimode",
      ".startup",
      ".footsw",
      ".rxch",
      ".deviceid",
      ".txinterval",
      ".deadtime"
    ],
    "writer_note": "Hosts omit .deviceid when writing global setup, because changing it mid-chain changes the device address.",
    "fields": {
      "midimode": {
        "statement": ".midimode",
        "type": "enum",
        "default": 2,
        "default_token": "U-3",
        "values": [
          "U-1",
          "U-2",
          "U-3",
          "U-4",
          "S-1",
          "S-2",
          "S-3",
          "S-4"
        ]
      },
      "startup": {
        "statement": ".startup",
        "type": "integer",
        "range": [
          0,
          32
        ],
        "default": 0,
        "tokens": {
          "0": "last",
          "1..32": "1..32"
        }
      },
      "footsw": {
        "statement": ".footsw",
        "type": "enum",
        "default": 2,
        "values": [
          "norm",
          "inv",
          "auto"
        ]
      },
      "rxch": {
        "statement": ".rxch",
        "type": "integer",
        "range": [
          -1,
          15
        ],
        "wire_value": "0=off, 1..16",
        "default": -1
      },
      "deviceid": {
        "statement": ".deviceid",
        "type": "integer",
        "range": [
          1,
          16
        ],
        "wire_value": "id-1",
        "default": 1
      },
      "txinterval": {
        "statement": ".txinterval",
        "type": "enum",
        "values": [
          2,
          5,
          10,
          20,
          50,
          100
        ],
        "defaults": {
          "BCR2000": 2,
          "BCF2000": 20
        }
      },
      "deadtime": {
        "statement": ".deadtime",
        "type": "integer",
        "range": [
          0,
          1000
        ],
        "unit": "milliseconds",
        "stored": "deadtime div 10",
        "defaults": {
          "BCR2000": 0,
          "BCF2000": 100
        }
      }
    }
  },
  "preset": {
    "selector": "$preset",
    "defaults": {
      "name": "24 spaces",
      "snapshot": false,
      "request": false,
      "egroups": 4,
      "fkeys": true,
      "lock": false,
      "learn_output": "cleared"
    },
    "statements": {
      ".name": {
        "syntax": ".name 'PresetName'",
        "length": [
          0,
          24
        ],
        "chars": "0x20..0x7F",
        "device_quirks": "apostrophe is the terminator; control chars <0x20 become '.' except NUL which truncates"
      },
      ".snapshot": {
        "syntax": ".snapshot off|on",
        "default": "off"
      },
      ".request": {
        "syntax": ".request off|on",
        "default": "off"
      },
      ".egroups": {
        "syntax": ".egroups 1|2|3|4",
        "default": 4
      },
      ".fkeys": {
        "syntax": ".fkeys off|on",
        "default": "on"
      },
      ".lock": {
        "syntax": ".lock off|on",
        "default": "off"
      },
      ".tx": {
        "syntax": ".tx b1 [b2 ... bN]",
        "role": "LEARN output",
        "bytes": "decimal 0..255 or hex $00..$FF",
        "buffer": 127,
        "fe_note": "$FE counts as two bytes"
      },
      ".init": {
        "syntax": ".init",
        "role": "clear all elements"
      }
    },
    "learn_output": {
      "buffer_bytes": 127,
      "statement_overhead": 2,
      "byte_overhead": {
        "0x00..0xFD": 1,
        "0xFE": 2,
        "0xFF": 1
      },
      "max_bytes_one_statement": 125,
      "max_bytes_two_statements": 123
    },
    "dump_order": [
      "$preset",
      ".name",
      ".snapshot",
      ".request",
      ".egroups",
      ".fkeys",
      ".lock",
      "learn output",
      ".init",
      "encoder sections",
      "button sections",
      "fader sections"
    ]
  },
  "element_common": {
    "defaults": {
      "standard_output": "cleared",
      "showvalue": false,
      "default": "off",
      "minmax": [
        0,
        0
      ],
      "custom_output": "cleared"
    },
    "statements": {
      ".easypar": {
        "role": "standard output",
        "side_effects": [
          "ShowValue := off",
          "Default := value depending on type",
          "CustomOutput := cleared"
        ]
      },
      ".showvalue": {
        "syntax": ".showvalue off|on",
        "default": "off"
      },
      ".default": {
        "syntax": ".default off|0..16383",
        "default": "off"
      },
      ".minmax": {
        "syntax": ".minmax Value1 Value2",
        "range": [
          0,
          16383
        ],
        "default": [
          0,
          0
        ]
      },
      ".tx": {
        "role": "custom output",
        "buffer": 127,
        "syntax": ".tx <items...>"
      },
      ".local": {
        "syntax": ".local off|on",
        "availability": [
          "button",
          "encoder"
        ],
        "note": "function unknown; never dumped by device"
      }
    },
    "dump_order": [
      ".easypar",
      ".showvalue",
      ".default",
      ".mode",
      ".minmax",
      ".tx"
    ]
  },
  "button": {
    "selector": "$button 1..64",
    "defaults": {
      "mode": "down",
      "increment": 1
    },
    "mode": {
      "statement": ".mode",
      "values": [
        "down",
        "updown",
        "toggle",
        "incval"
      ],
      "incval_syntax": ".mode incval Increment",
      "increment_range": "[-127,-1] U [1,127]"
    },
    "standard_types": [
      "PC",
      "CC",
      "NRPN",
      "NOTE",
      "AT",
      "MMC",
      "GS/XG"
    ],
    "standard_modes": [
      "toggleoff",
      "toggleon",
      "increment"
    ],
    "dump_order": [
      ".easypar",
      ".showvalue",
      ".default",
      ".mode",
      ".minmax",
      ".tx"
    ],
    "increment_algorithm": {
      "initial": "Value = Default",
      "press": "N = Value + Increment",
      "positive": "if N > Value1 then Value = Value2 else Value = N",
      "negative": "if N < Value2 then Value = Value1 else Value = N",
      "note": "For .easypar, Value1 must be greater than Value2; for custom incval, .minmax values are swapped (Value1 < Value2)."
    }
  },
  "encoder": {
    "selector": "$encoder 1..56 (BCR), 1..32 (BCF)",
    "defaults": {
      "mode": "off",
      "resolutions": [
        0,
